/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'
/engine/*
  Cache-Control: public, max-age=31536000, immutable
/engine/*.wasm
  Content-Type: application/wasm
/engine/*.mjs
  Content-Type: text/javascript; charset=utf-8
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/version.json
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/embed/*
  Access-Control-Allow-Origin: *
