{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmap.zhovten.games/schema/roadmap-project-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "terminologyProfile",
    "selectedIntentId",
    "intents",
    "routes",
    "modules",
    "chunks",
    "intersections",
    "estimates",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "maxLength": 1024,
      "minLength": 1
    },
    "terminologyProfile": {
      "type": "string",
      "enum": [
        "engineering",
        "simple",
        "product",
        "literary"
      ]
    },
    "selectedIntentId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "intents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/intent"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "chunks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chunk"
      }
    },
    "intersections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/intersection"
      }
    },
    "estimates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/estimate"
      }
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "formatVersion": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "status",
        "order"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "maxLength": 16384
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "implemented",
            "deferred"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "stereotype",
        "linkedModuleIds",
        "linkedChunkIds",
        "order"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "stereotype": {
          "type": "string",
          "enum": [
            "intent",
            "module",
            "shared",
            "validation",
            "export"
          ]
        },
        "estimateId": {
          "type": "string"
        },
        "linkedModuleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "linkedChunkIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "intentId",
        "title",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        },
        "intentId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "maxItems": 2000
        }
      }
    },
    "codeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "revision",
        "symbol"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "maxLength": 16384,
          "minLength": 1
        },
        "path": {
          "type": "string",
          "maxLength": 16384,
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "kind",
        "linkedIntentIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "maxLength": 16384
        },
        "kind": {
          "type": "string",
          "enum": [
            "core",
            "ui",
            "storage",
            "export",
            "demo",
            "validation"
          ]
        },
        "linkedIntentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "body",
        "linkedIntentIds",
        "linkedModuleIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "body": {
          "type": "string",
          "maxLength": 262144
        },
        "linkedIntentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "linkedModuleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "intersection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "sourceIds",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 64
          },
          "minItems": 2
        },
        "note": {
          "type": "string",
          "maxLength": 16384
        }
      }
    },
    "estimateValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "metric",
            "minMinutes",
            "maxMinutes"
          ],
          "properties": {
            "type": {
              "const": "range"
            },
            "metric": {
              "type": "string",
              "enum": [
                "effort",
                "elapsed"
              ]
            },
            "minMinutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "maxMinutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "reason"
          ],
          "properties": {
            "type": {
              "const": "unknown"
            },
            "reason": {
              "type": "string",
              "maxLength": 16384,
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "reason"
          ],
          "properties": {
            "type": {
              "const": "not-applicable"
            },
            "reason": {
              "type": "string",
              "maxLength": 16384,
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "maxLength": 16384
            }
          }
        }
      ]
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "maxLength": 16384
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    }
  }
}
