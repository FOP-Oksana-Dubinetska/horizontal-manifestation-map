{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-debug",
      "displayName": "native-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HMAP_ENABLE_TESTS": "ON",
        "HMAP_ENABLE_SANITIZERS": "OFF",
        "HMAP_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "native-release",
      "displayName": "native-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HMAP_ENABLE_TESTS": "ON",
        "HMAP_ENABLE_SANITIZERS": "OFF",
        "HMAP_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "native-sanitize",
      "displayName": "native-sanitize",
      "inherits": "native-debug",
      "binaryDir": "${sourceDir}/build/native-sanitize",
      "cacheVariables": {
        "HMAP_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "wasm-debug",
      "displayName": "wasm-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm-debug",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HMAP_ENABLE_TESTS": "OFF",
        "HMAP_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "wasm-release",
      "displayName": "wasm-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm-release",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HMAP_ENABLE_TESTS": "OFF",
        "HMAP_ENABLE_SANITIZERS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release"
    },
    {
      "name": "native-sanitize",
      "configurePreset": "native-sanitize"
    },
    {
      "name": "wasm-debug",
      "configurePreset": "wasm-debug"
    },
    {
      "name": "wasm-release",
      "configurePreset": "wasm-release"
    }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-sanitize",
      "configurePreset": "native-sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wasm-debug",
      "configurePreset": "wasm-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wasm-release",
      "configurePreset": "wasm-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
